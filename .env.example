# FactoryFlow Environment Configuration
DEBUG=True
SECRET_KEY=replace-with-a-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Default is SQLite, set USE_POSTGRES=True for PostgreSQL)
USE_POSTGRES=False
DATABASE_PATH=db.sqlite3
DB_NAME=factoryflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Business configuration
LOW_STOCK_RAW_MATERIAL_THRESHOLD=50.0000
